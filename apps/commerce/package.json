{
  "name": "@guapo/commerce",
  "version": "0.0.1",
  "description": "Guapo Commerce Backend (Medusa)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "sync:payload": "medusa exec ./src/scripts/sync-payload-products.ts",
    "simulate-renewal": "medusa exec ./src/scripts/simulate-renewal.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "db:setup": "medusa db:setup",
    "db:migrate": "medusa db:migrate",
    "predeploy": "medusa db:migrate",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests"
  },
  "dependencies": {
    "react-router-dom": "^6.30.3",
    "stripe": "^17.4.0",
    "@lambdacurry/medusa-product-reviews": "^1.3.0",
    "@medusajs/admin-sdk": "2.13.1",
    "@medusajs/admin-shared": "2.13.1",
    "@medusajs/cli": "2.13.1",
    "@medusajs/dashboard": "2.13.1",
    "@medusajs/draft-order": "2.13.1",
    "@medusajs/file-s3": "2.13.1",
    "@medusajs/framework": "2.13.1",
    "@medusajs/icons": "2.13.1",
    "@medusajs/medusa": "2.13.1",
    "@medusajs/types": "2.13.1",
    "@medusajs/ui": "4.1.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "latest",
    "@swc/core": "^1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11"
  },
  "engines": {
    "node": ">=20"
  }
}
