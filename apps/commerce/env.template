# Guapo Commerce Backend Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================
# Get this from Supabase Dashboard > Settings > Database > Connection String
# Use the "Session mode" pooler URL for development
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# =============================================================================
# REDIS (Optional in development)
# =============================================================================
# In development, leave this empty to use in-memory modules
# In production, use Railway Redis or similar
# REDIS_URL=redis://localhost:6379

# =============================================================================
# CORS Configuration
# =============================================================================
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# =============================================================================
# HTTP / Security
# =============================================================================
# Change these in production!
JWT_SECRET=supersecret-jwt-change-in-production
COOKIE_SECRET=supersecret-cookie-change-in-production

# =============================================================================
# AUTH (Customer login: emailpass + Google)
# =============================================================================
# Full guide: apps/commerce/docs/GOOGLE-OAUTH-SETUP.md
# 1) Google Cloud Console → Credentials → Create OAuth client ID (Web application)
# 2) Add Authorized redirect URIs (full path): .../da/auth/google/callback and .../en/auth/google/callback per env
# 3) Copy Client ID and Client secret here
# Storefront passes callback_url per request (with locale) so redirect preserves locale; GOOGLE_CALLBACK_URL is fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/da/auth/google/callback

# =============================================================================
# PAYLOAD SYNC (Medusa → Payload CMS)
# =============================================================================
# CMS app URL (e.g. http://localhost:3001). Medusa calls Payload API to create/delete products.
PAYLOAD_SERVER_URL=http://localhost:3001
# Option 1 – API key: Payload Admin → Users → [vælg bruger] → Enable API Key → kopiér nøgle. Se apps/cms/docs/payload-api-key-for-medusa.md.
PAYLOAD_API_KEY=
# Option 2 – Sync secret (nemmere): sæt samme hemmelighed i apps/cms som PAYLOAD_MEDUSA_SYNC_SECRET; lad PAYLOAD_API_KEY være tom.
# PAYLOAD_MEDUSA_SYNC_SECRET=
# Payload user collection name for API key auth (default: users)
# PAYLOAD_USER_COLLECTION=users

# =============================================================================
# MEDUSA Configuration
# =============================================================================
# Base URL for Admin PDF label links (Shipmondo proxy). Must match the URL you open Admin on (e.g. production host).
MEDUSA_BACKEND_URL=http://localhost:9000

# Worker Mode (shared|server|worker)
# - shared: runs both server and worker in same process (development)
# - server: runs only API server (production - server instance)
# - worker: runs only background jobs (production - worker instance)
MEDUSA_WORKER_MODE=shared

# Admin Dashboard
DISABLE_MEDUSA_ADMIN=false

# =============================================================================
# FILE STORAGE (Supabase S3-compatible, for product images)
# =============================================================================
# From Supabase Dashboard > Settings > Storage > S3 API
# Create bucket "medusa" (public). S3_FILE_URL = public base URL for the bucket.
# Format: https://<project-ref>.supabase.co/storage/v1/object/public/medusa
S3_BUCKET=medusa
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=eu-west-3
S3_FILE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/medusa

# =============================================================================
# STRIPE (Payments: cards, Apple Pay, Google Pay; MobilePay/Klarna when enabled)
# =============================================================================
# Secret key (sk_*) from Stripe Dashboard – used by Medusa for payment processing
STRIPE_API_KEY=
# Webhook secret (whsec_*) – required for deployed environments. Create in Stripe Dashboard → Webhooks.
# Storefront uses NEXT_PUBLIC_STRIPE_KEY (pk_*) – add to apps/storefront/.env.local
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_KEY=

# =============================================================================
# SHIPMONDO (Shipping: GLS/DAO pakkeshop, 39 DKK flat rate)
# =============================================================================
# See apps/commerce/docs/SHIPMONDO.md for API docs.
# If not set, fulfillment module still works with manual provider only; Shipmondo option unavailable.

# Recommended: Shipping Module Key for pakkeshop search (read-only, no sandbox needed).
# Create at Shipmondo → Settings → Shipping Module Key (Delivery Checkout).
# Works in production immediately; no cost for pickup point lookups.
SHIPMONDO_SHIPPING_MODULE_KEY=

# Fallback for pakkeshop search + required for label creation: API User + Key.
# From Shipmondo API access: https://app.shipmondo.com/main/app/#/setting/api
SHIPMONDO_API_USER=
SHIPMONDO_API_KEY=

# Label format for POST /shipments and GET /shipments/{id}/labels (a4_pdf, 10x19_pdf, zpl, compact_pdf).
# Required for Shipmondo to include label PDF in the API response.
SHIPMONDO_LABEL_FORMAT=10x19_pdf

# Optional: set POST /shipments body `print: true` (Shipmondo Print Client). Default is false. Label PDF is still loaded via GET when the API returns it.
# SHIPMONDO_SHIPMENT_PRINT=true

# Label PDF may appear in GET /shipments/{id} a few seconds after POST (GLS etc.). Default: 5 GET attempts, 3s apart.
# SHIPMONDO_LABEL_GET_MAX_ATTEMPTS=5
# SHIPMONDO_LABEL_GET_RETRY_MS=3000

# Debug: log JSON shape (top-level keys + parcel key names only — no PDF/base64). Use when labels stay empty.
# SHIPMONDO_DEBUG_SHIPMENT_RESPONSE=true

# HTTP timeouts (milliseconds). POST /shipments uses 60s by default — GLS/carrier booking often needs >10s.
# GET/DELETE use 10s. If Medusa shows "aborted" but Shipmondo has the shipment, increase SHIPMONDO_SHIPMENT_TIMEOUT_MS.
# SHIPMONDO_REQUEST_TIMEOUT_MS=10000
# SHIPMONDO_SHIPMENT_TIMEOUT_MS=60000

# Use sandbox for label creation (https://sandbox.shipmondo.com); request access from Shipmondo support.
# SHIPMONDO_SANDBOX=true

# Dry-run: simulate fulfillment without creating real labels (for testing).
# Set to "true" to test checkout → order → fulfillment flow without buying labels.
# SHIPMONDO_DRY_RUN=true

# Webhook (optional): same encryption key as in Shipmondo → Settings → Webhook. Endpoint: POST /hooks/shipmondo
# SHIPMONDO_WEBHOOK_ENCRYPTION_KEY=

# Store rate limit for /store/pickup-points and /store/shipping-options-with-pricing (per IP, ~120/min default).
# SHIPMONDO_STORE_RATE_LIMIT_MAX=120
# SHIPMONDO_STORE_RATE_LIMIT_DISABLED=true

# Optional: sender address used when creating labels (defaults in code if unset)
# Optional Shipmondo sender **overrides** (Medusa stock location address is used first — see SHIPMONDO.md).
# Required only if the fulfillment location has no address / incomplete DK postcode / no sender email (metadata or below).
# With SHIPMONDO_SANDBOX=true, placeholders fill gaps when env + stock location are incomplete.
# SHIPMONDO_SENDER_NAME=Guapo
# SHIPMONDO_SENDER_ADDRESS=
# SHIPMONDO_SENDER_POSTAL=
# SHIPMONDO_SENDER_CITY=
# SHIPMONDO_SENDER_COUNTRY=DK
# SHIPMONDO_SENDER_EMAIL=
# SHIPMONDO_SENDER_PHONE=
# Prefer **Shipping profile → Metadata** in Admin: `sender_email` (required for carrier without env), optional `sender_name`, `sender_phone`.

# Checkout carriers: default GLS + DAO + PostNord (comma-separated Shipmondo product codes). No GET /products needed.
# Set to __API__ to use dynamic product list from Shipmondo + shipmondo_enabled_products instead.
# SHIPMONDO_CHECKOUT_CARRIER_CODES=GLSDK_SD,DAO_SD,POSTDK_SD

# PostNord product code from Shipmondo GET /products?country_code=DK (replace POSTDK_SD if yours differs).
# SHIPMONDO_POSTNORD_PRODUCT_CODE=POSTDK_SD

# Pricing / carriers: primary source is Medusa Admin (option.data.price_bands, flat_amount_minor).
# Below are fallback only when option has no price data:
# SHIPMONDO_FLAT_RATE_MINOR=3900
# SHIPMONDO_PRICE_BANDS=[{"max_grams":2000,"amount_minor":3900},{"max_grams":5000,"amount_minor":4900}]
# SHIPMONDO_SERVICE_CODES=EMAIL_NT

# =============================================================================
# PLUNK (Transactional email – Next API: https://next-api.useplunk.com)
# =============================================================================
# Secret key (sk_*) from Plunk dashboard – used for invite emails, order emails, etc.
# PLUNK_SECRET_KEY=
# Sender address (verified domain in Plunk). Required for sending.
# PLUNK_FROM_EMAIL=no-reply@yourdomain.com
# PLUNK_FROM_NAME=Guapo
# Store name used in invite email subject/body
# PLUNK_STORE_NAME=Guapo
# Public storefront origin used in transactional email links
# STOREFRONT_URL=http://localhost:3000
# Rate limit for authenticated PDF downloads (/store/orders/:id/documents/:type)
# ORDER_DOCUMENTS_RATE_LIMIT_MAX=40
# ORDER_DOCUMENTS_RATE_LIMIT_DISABLED=true
# Public base URL for email images (hero, logo) — same bucket/folder as newsletter templates
# GUAPO_EMAIL_ASSET_BASE=https://tknxlzoejhauuzloezfi.supabase.co/storage/v1/object/public/newsletter

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 1. Run migrations: pnpm db:migrate
# 2. Seed database: pnpm seed
# 3. Start server: pnpm dev
# 4. Admin Dashboard: http://localhost:9000/app
# 5. Store API: http://localhost:9000/store/*
