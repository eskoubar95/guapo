# Guapo Commerce Backend Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================
# Get this from Supabase Dashboard > Settings > Database > Connection String
# Use the "Session mode" pooler URL for development
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# =============================================================================
# REDIS (Optional in development)
# =============================================================================
# In development, leave this empty to use in-memory modules
# In production, use Railway Redis or similar
# REDIS_URL=redis://localhost:6379

# =============================================================================
# CORS Configuration
# =============================================================================
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# =============================================================================
# HTTP / Security
# =============================================================================
# Change these in production!
JWT_SECRET=supersecret-jwt-change-in-production
COOKIE_SECRET=supersecret-cookie-change-in-production

# =============================================================================
# MEDUSA Configuration
# =============================================================================
MEDUSA_BACKEND_URL=http://localhost:9000

# Worker Mode (shared|server|worker)
# - shared: runs both server and worker in same process (development)
# - server: runs only API server (production - server instance)
# - worker: runs only background jobs (production - worker instance)
MEDUSA_WORKER_MODE=shared

# Admin Dashboard
DISABLE_MEDUSA_ADMIN=false

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 1. Run migrations: pnpm db:migrate
# 2. Seed database: pnpm seed
# 3. Start server: pnpm dev
# 4. Admin Dashboard: http://localhost:9000/app
# 5. Store API: http://localhost:9000/store/*
