# Guapo Commerce Backend Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================
# Get this from Supabase Dashboard > Settings > Database > Connection String
# Use the "Session mode" pooler URL for development
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# =============================================================================
# REDIS (Optional in development)
# =============================================================================
# In development, leave this empty to use in-memory modules
# In production, use Railway Redis or similar
# REDIS_URL=redis://localhost:6379

# =============================================================================
# CORS Configuration
# =============================================================================
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# =============================================================================
# HTTP / Security
# =============================================================================
# Change these in production!
JWT_SECRET=supersecret-jwt-change-in-production
COOKIE_SECRET=supersecret-cookie-change-in-production

# =============================================================================
# AUTH (Customer login: emailpass + Google)
# =============================================================================
# Google OAuth: create credentials in Google Cloud Console, set redirect URI to
# your storefront callback (e.g. http://localhost:3000/da/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/da/auth/google/callback

# =============================================================================
# PAYLOAD SYNC (Medusa → Payload CMS)
# =============================================================================
# CMS app URL (e.g. http://localhost:3001). Medusa calls Payload API to create/delete products.
PAYLOAD_SERVER_URL=http://localhost:3001
# Option 1 – API key: Payload Admin → Users → [vælg bruger] → Enable API Key → kopiér nøgle. Se apps/cms/docs/payload-api-key-for-medusa.md.
PAYLOAD_API_KEY=
# Option 2 – Sync secret (nemmere): sæt samme hemmelighed i apps/cms som PAYLOAD_MEDUSA_SYNC_SECRET; lad PAYLOAD_API_KEY være tom.
# PAYLOAD_MEDUSA_SYNC_SECRET=
# Payload user collection name for API key auth (default: users)
# PAYLOAD_USER_COLLECTION=users

# =============================================================================
# MEDUSA Configuration
# =============================================================================
MEDUSA_BACKEND_URL=http://localhost:9000

# Worker Mode (shared|server|worker)
# - shared: runs both server and worker in same process (development)
# - server: runs only API server (production - server instance)
# - worker: runs only background jobs (production - worker instance)
MEDUSA_WORKER_MODE=shared

# Admin Dashboard
DISABLE_MEDUSA_ADMIN=false

# =============================================================================
# FILE STORAGE (Supabase S3-compatible, for product images)
# =============================================================================
# From Supabase Dashboard > Settings > Storage > S3 API
# Create bucket "medusa" (public). S3_FILE_URL = public base URL for the bucket.
# Format: https://<project-ref>.supabase.co/storage/v1/object/public/medusa
S3_BUCKET=medusa
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=eu-west-3
S3_FILE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/medusa

# =============================================================================
# PLUNK (Transactional email – Next API: https://next-api.useplunk.com)
# =============================================================================
# Secret key (sk_*) from Plunk dashboard – used for invite emails, order emails, etc.
# PLUNK_SECRET_KEY=
# Sender address (verified domain in Plunk). Required for sending.
# PLUNK_FROM_EMAIL=no-reply@yourdomain.com
# PLUNK_FROM_NAME=Guapo
# Store name used in invite email subject/body
# PLUNK_STORE_NAME=Guapo

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 1. Run migrations: pnpm db:migrate
# 2. Seed database: pnpm seed
# 3. Start server: pnpm dev
# 4. Admin Dashboard: http://localhost:9000/app
# 5. Store API: http://localhost:9000/store/*
