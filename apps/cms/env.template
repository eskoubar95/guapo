# Guapo CMS (Payload) Environment Variables
# Copy this file to .env in this directory (apps/cms) and fill in the values

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================
# Must point to the same Supabase instance as Commerce; Payload uses schema "payload".
# Get from Supabase Dashboard > Settings > Database > Connection String.
# Use "Session mode" pooler URL for development.
# Username must be postgres.<project-ref> (Project Settings > General > Reference ID).
# Password = Database password (Settings > Database), not anon/service_role key.
# If password has @ # % etc., URL-encode it. If you get "Tenant or user not found", try the Direct connection URI from the dashboard instead.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# =============================================================================
# MEDUSA (Store API – for CMS dropdowns / sync)
# =============================================================================
# Same backend as storefront. Used by CMS to load products, categories, types, brands for admin dropdowns.
# Example: http://localhost:9000
MEDUSA_STORE_URL=http://localhost:9000

# =============================================================================
# PAYLOAD
# =============================================================================
# Required in production; in development a fallback is used if unset
PAYLOAD_SECRET=<YOUR_PAYLOAD_SECRET>

# =============================================================================
# MEDIA STORAGE (Optional – Supabase S3-compatible)
# =============================================================================
# Uncomment and set when enabling @payloadcms/storage-s3 in payload.config.ts
# S3_BUCKET=media
# S3_ENDPOINT=<SUPABASE_S3_ENDPOINT>
# S3_ACCESS_KEY_ID=<SUPABASE_ACCESS_KEY>
# S3_SECRET_ACCESS_KEY=<SUPABASE_SECRET_KEY>
# S3_REGION=auto
