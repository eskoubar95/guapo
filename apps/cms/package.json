{
  "name": "@guapo/cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation\" next dev --turbopack -p 3001",
    "dev:webpack": "cross-env NODE_OPTIONS=\"--no-deprecation\" next dev -p 3001",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation\" next build",
    "start": "cross-env NODE_OPTIONS=\"--no-deprecation\" next start -p 3001",
    "lint": "next lint",
    "payload": "cross-env NODE_OPTIONS=\"--no-deprecation\" PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "generate:types": "payload generate:types",
    "generate:schema": "payload generate:db-schema",
    "migrate": "pnpm payload migrate",
    "migrate:create": "pnpm payload migrate:create",
    "migrate:status": "pnpm payload migrate:status"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.74.0",
    "@payloadcms/next": "3.74.0",
    "@payloadcms/plugin-seo": "3.74.0",
    "@payloadcms/richtext-lexical": "3.74.0",
    "@payloadcms/storage-s3": "3.74.0",
    "@payloadcms/translations": "3.74.0",
    "@payloadcms/ui": "3.74.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.9.0",
    "next": "^15.1.0",
    "payload": "3.74.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5.7.2"
  }
}
