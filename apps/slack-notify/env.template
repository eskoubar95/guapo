# Slack notify service (names only — copy to Railway or .env locally)
PORT=8080
# Shared secret: same value as NOTIFY_SHARED_SECRET on Medusa (server + worker)
NOTIFY_SHARED_SECRET=
# Slack bot token (xoxb-...) — chat:write scope; invite bot to Shop, Alerts, Inventory channels
SLACK_BOT_TOKEN=
# Channel IDs (Slack → channel name → copy ID)
SLACK_CHANNEL_SHOP=
SLACK_CHANNEL_ALERTS=
SLACK_CHANNEL_INVENTORY=
# Signing: Medusa sends X-Notify-Timestamp (Unix ms) + X-Notify-Signature = sha256(HMAC(secret, `${timestamp}.${body}`)).
# Optional single JSON instead of three vars: {"shop":"C111","alerts":"C222","inventory":"C333"}
# SLACK_CHANNELS_JSON=
# Base URL of Medusa HTTP API (for /v1/test/replay → GET /internal/notifications/slack/sample)
GUAPO_COMMERCE_INTERNAL_URL=https://your-medusa.up.railway.app
# Optional: origin of Medusa Admin for deep links in Block Kit (no trailing slash)
GUAPO_MEDUSA_ADMIN_BASE_URL=https://your-medusa.up.railway.app/app
