# Guapo Storefront Environment Variables
# Copy this file to .env.local and fill in the values

# Site URL (canonical origin for metadata, sitemap, OG). In production set to https://guapo.store (or your domain).
# Server-side fallbacks: STOREFRONT_URL, then VERCEL_URL / RAILWAY_PUBLIC_DOMAIN — but prefer NEXT_PUBLIC_SITE_URL so URLs are correct at build/runtime.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# STOREFRONT_URL=https://guapo.store

# Medusa Backend
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=<YOUR_MEDUSA_PUBLISHABLE_KEY>

# Stripe (PaymentElement in checkout – publishable key pk_* from Stripe Dashboard)
NEXT_PUBLIC_STRIPE_KEY=<YOUR_STRIPE_PUBLISHABLE_KEY>

# Checkout: show Klarna as a payment option (omit or false at launch)
# NEXT_PUBLIC_CHECKOUT_ENABLE_KLARNA=true

# CMS (Payload) - for server-side content fetching (categories, homepage, etc.)
# Use the public CMS base URL on Railway. Either variable works; if you only set one, prefer NEXT_PUBLIC_PAYLOAD_API_URL so media URLs match.
PAYLOAD_API_URL=http://localhost:3001
# NEXT_PUBLIC_PAYLOAD_API_URL=http://localhost:3001

# Storefront locales: comma-separated codes. When set, overrides Payload Site settings → `enabledStorefrontLocales`.
# Omit to follow Payload (default in CMS: Danish only until English is enabled). Example for launch: `da,en`
# PUBLISHED_LOCALES=da
# Future: read locales from Medusa instead of Payload (not implemented yet)
# STOREFRONT_LOCALE_SOURCE=medusa

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=<YOUR_POSTHOG_KEY>
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Google Tag Manager — optional fallback if not enabled in CMS (Payload → Tracking & Tag Manager).
# When GTM is active, leave NEXT_PUBLIC_GA_MEASUREMENT_ID unset to avoid duplicate GA4 page views.
# NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX

# Direct GA4 (only if GTM is not used)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Category PLP: set to true to show hardcoded filter UI (default: hidden for launch)
# NEXT_PUBLIC_ENABLE_CATEGORY_PLP_FILTERS=true
