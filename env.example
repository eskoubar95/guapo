# Guapo env var inventory (names only; no secrets)
#
# Notes:
# - This is a repo-wide inventory. When apps are scaffolded, we may split these into
#   workspace-specific files (e.g. `apps/storefront/.env.local`, `apps/cms/.env`, etc.).
# - Replace placeholders like <YOUR_...> locally; never commit real secrets.
#

## Shared / infrastructure
DATABASE_URL=<YOUR_DATABASE_URL>
REDIS_URL=<YOUR_REDIS_URL>
SENTRY_DSN=<YOUR_SENTRY_DSN>

## Storefront (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

## CMS (Payload)
PAYLOAD_SECRET=<YOUR_PAYLOAD_SECRET>

## Payments (Adyen)
ADYEN_MERCHANT_ACCOUNT=<YOUR_ADYEN_MERCHANT_ACCOUNT>
ADYEN_API_KEY=<YOUR_ADYEN_API_KEY>
ADYEN_CLIENT_KEY=<YOUR_ADYEN_CLIENT_KEY>

## Email (Plunk)
EMAIL_PROVIDER_API_KEY=<YOUR_PLUNK_API_KEY>

