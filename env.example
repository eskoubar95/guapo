# Guapo env var inventory (names only; no secrets)
#
# Notes:
# - This is a repo-wide inventory. Workspace-specific files are:
#   - apps/storefront/.env.local
#   - apps/commerce/env.template
#   - apps/cms/.env
# - Replace placeholders like <YOUR_...> locally; never commit real secrets.
#

## Shared / infrastructure
DATABASE_URL=<YOUR_DATABASE_URL>
REDIS_URL=<YOUR_REDIS_URL>
SENTRY_DSN=<YOUR_SENTRY_DSN>

## Storefront (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=<YOUR_MEDUSA_PUBLISHABLE_KEY>

# Analytics (cookie consent required; set for PostHog + GA4 / GTM)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional fallback when GTM is not enabled in CMS (Payload → Tracking)
NEXT_PUBLIC_GTM_CONTAINER_ID=

## Commerce (Medusa)
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

## CMS (Payload)
PAYLOAD_SECRET=<YOUR_PAYLOAD_SECRET>

## Payments (Stripe)
STRIPE_API_KEY=<YOUR_STRIPE_API_KEY>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>
NEXT_PUBLIC_STRIPE_KEY=<YOUR_STRIPE_PUBLISHABLE_KEY>

## Email (Plunk)
EMAIL_PROVIDER_API_KEY=<YOUR_PLUNK_API_KEY>
PLUNK_SECRET_KEY=<YOUR_PLUNK_SECRET_KEY>
PLUNK_FROM_EMAIL=
PLUNK_FROM_NAME=Guapo
PLUNK_STORE_NAME=Guapo
STOREFRONT_URL=http://localhost:3000

## Commerce — ordre/faktura-PDF
# Sælger/CVR/logo/fodnoter: Medusa Admin → Regions → DKK-region → Metadata (flat keys eller `guapo_invoice`).
# Se apps/commerce/src/lib/documents/resolve-pdf-seller.ts — GUAPO_INVOICE_* bruges ikke til PDF.

